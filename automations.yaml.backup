- id: '1760963587057'
  alias: Wohnzimmer_Terrarium_Warmup_Cooldown_Konsistenz
  description: Stellt sicher, dass immer nur Warmup oder Cooldown gleichzeitig aktiviert
    ist.
  triggers:
  - entity_id: input_boolean.wohnzimmer_terrarium_warmup_active
    to: 'on'
    trigger: state
  - entity_id: input_boolean.wohnzimmer_terrarium_cooldown_active
    to: 'on'
    trigger: state
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_terrarium_timer_active
    state: 'on'
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: "{{ trigger.entity_id == 'input_boolean.wohnzimmer_terrarium_warmup_active' }}"
      sequence:
      - target:
          entity_id: input_boolean.wohnzimmer_terrarium_cooldown_active
        action: input_boolean.turn_off
      - data:
          message: '[Terrarium] Cooldown deaktiviert, da Warmup aktiviert wurde.'
          level: info
        action: system_log.write
    - conditions:
      - condition: template
        value_template: "{{ trigger.entity_id == 'input_boolean.wohnzimmer_terrarium_cooldown_active' }}"
      sequence:
      - target:
          entity_id: input_boolean.wohnzimmer_terrarium_warmup_active
        action: input_boolean.turn_off
      - data:
          message: '[Terrarium] Warmup deaktiviert, da Cooldown aktiviert wurde.'
          level: info
        action: system_log.write
  mode: single
- id: '1769877256193'
  alias: Wohnzimmer_Terrarium_Warmup
  description: Täglicher Warmup bis 14h
  triggers:
  - at: 00:01:00
    trigger: time
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_terrarium_warmup_active
    state: 'on'
  actions:
  - data:
      level: warning
      message: '[WARMUP] Started'
    action: system_log.write
  - choose:
    - conditions:
      - condition: template
        value_template: "\n{% set on = states('input_datetime.wohnzimmer_terrarium_lampe1_on')
          %} {% set off = states('input_datetime.wohnzimmer_terrarium_lampe1_off')
          %}\n{% if on in ['unknown','unavailable',''] or off in ['unknown','unavailable','']
          %}\n  false\n{% else %}\n  {% set on_dt = strptime(on,'%H:%M:%S') %}\n  {%
          set off_dt = strptime(off,'%H:%M:%S') %}\n  {{ ((off_dt-on_dt).seconds/3600)
            >= states('input_number.wohnzimmer_terrarium_max_time') | float(0) }}\n{% endif %}\n"
      sequence:
      - data:
          level: warning
          message: '[WARMUP] Max reached → stop'
        action: system_log.write
      - target:
          entity_id: input_boolean.wohnzimmer_terrarium_warmup_active
        action: input_boolean.turn_off
    default:
    - data:
        level: warning
        message: '[WARMUP] Applying +1h'
      action: system_log.write
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe1_on
        time: "\n{% set t = states('input_datetime.wohnzimmer_terrarium_lampe1_on')
          %}\n{% if t not in ['unknown','unavailable',''] %}\n  {{ (strptime(t,'%H:%M:%S')
          - timedelta(minutes=30)).strftime('%H:%M:%S') }}\n{% else %}\n  {{ t }}\n{%
          endif %}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe1_off
        time: "\n{% set t = states('input_datetime.wohnzimmer_terrarium_lampe1_off')
          %}\n{% if t not in ['unknown','unavailable',''] %}\n  {{ (strptime(t,'%H:%M:%S')
          + timedelta(minutes=30)).strftime('%H:%M:%S') }}\n{% else %}\n  {{ t }}\n{%
          endif %}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe2_on
        time: "\n{% set t = states('input_datetime.wohnzimmer_terrarium_lampe2_on')
          %}\n{% if t not in ['unknown','unavailable',''] %}\n  {{ (strptime(t,'%H:%M:%S')
          - timedelta(minutes=30)).strftime('%H:%M:%S') }}\n{% else %}\n  {{ t }}\n{%
          endif %}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe2_off
        time: "\n{% set t = states('input_datetime.wohnzimmer_terrarium_lampe2_off')
          %}\n{% if t not in ['unknown','unavailable',''] %}\n  {{ (strptime(t,'%H:%M:%S')
          + timedelta(minutes=30)).strftime('%H:%M:%S') }}\n{% else %}\n  {{ t }}\n{%
          endif %}\n"
      action: input_datetime.set_datetime
- id: '1769878981192'
  alias: Wohnzimmer_Terrarium_Cooldown
  description: 'Täglicher Cooldown: Beleuchtungsdauer um 1h verkürzen bis 0. Danach
    Timer & Cooldown aus (Winterschlaf).

    '
  triggers:
  - at: 00:01:00
    trigger: time
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_terrarium_cooldown_active
    state: 'on'
  actions:
  - data:
      level: info
      message: '[COOLDOWN] Started'
    action: system_log.write
  - variables:
      l1_on: '{{ states(''input_datetime.wohnzimmer_terrarium_lampe1_on'') }}'
      l1_off: '{{ states(''input_datetime.wohnzimmer_terrarium_lampe1_off'') }}'
      l2_on: '{{ states(''input_datetime.wohnzimmer_terrarium_lampe2_on'') }}'
      l2_off: '{{ states(''input_datetime.wohnzimmer_terrarium_lampe2_off'') }}'
  - variables:
      d1: "{{ (as_timestamp('1970-01-01 ' ~ l1_off) -\n    as_timestamp('1970-01-01
        ' ~ l1_on)) / 3600 }}\n"
      d2: "{{ (as_timestamp('1970-01-01 ' ~ l2_off) -\n    as_timestamp('1970-01-01
        ' ~ l2_on)) / 3600 }}\n"
      min_current: '{{ [d1, d2] | min }}'
  - data:
      level: info
      message: '[COOLDOWN] Current hours: {{ min_current }}

        '
    action: system_log.write
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ min_current <= 1 }}'
      sequence:
      - data:
          level: info
          message: '[COOLDOWN] Finished → Winter mode'
        action: system_log.write
      - target:
          entity_id:
          - input_boolean.wohnzimmer_terrarium_cooldown_active
          - input_boolean.wohnzimmer_terrarium_timer_active
        action: input_boolean.turn_off
    default:
    - data:
        level: info
        message: '[COOLDOWN] Applying -1h'
      action: system_log.write
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe1_on
        time: "{{ (strptime(l1_on,'%H:%M:%S') +\n    timedelta(minutes=30)).strftime('%H:%M:%S')
          }}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe1_off
        time: "{{ (strptime(l1_off,'%H:%M:%S') -\n    timedelta(minutes=30)).strftime('%H:%M:%S')
          }}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe2_on
        time: "{{ (strptime(l2_on,'%H:%M:%S') +\n    timedelta(minutes=30)).strftime('%H:%M:%S')
          }}\n"
      action: input_datetime.set_datetime
    - data:
        entity_id: input_datetime.wohnzimmer_terrarium_lampe2_off
        time: "{{ (strptime(l2_off,'%H:%M:%S') -\n    timedelta(minutes=30)).strftime('%H:%M:%S')
          }}\n"
      action: input_datetime.set_datetime
- id: '1769945515058'
  alias: Wohnzimmer_Terrarium_Timer_Guard
  description: Schaltet Lampen aus, wenn Timer deaktiviert wird
  triggers:
  - entity_id: input_boolean.wohnzimmer_terrarium_timer_active
    to: 'off'
    trigger: state
  actions:
  - target:
      entity_id:
      - switch.wohnzimmer_smartplug_terrarium_1
      - switch.wohnzimmer_smartplug_terrarium_2
    action: switch.turn_off
  - data:
      message: '[Timer Guard] Timer deaktiviert – Lampen ausgeschaltet'
      level: info
    action: system_log.write
  mode: single
