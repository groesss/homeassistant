- id: '1714417689648'
  alias: Wohnzimmer TV AmbiLights ein
  description: Schaltet das Schranklicht bei Fernseher ein, nur nachts.
  triggers:
  - device_id: abfc6f43b455bcd3e650dcf12b20f75e
    domain: media_player
    entity_id: media_player.wohnzimmer_tv
    type: turned_on
    trigger: device
  conditions:
  - condition: template
    value_template: '{% set now_time = now() %} {% set dusk = states(''sensor.sun_next_dusk'')
      | as_datetime %} {% set dawn = states(''sensor.sun_next_dawn'') | as_datetime
      %} {{ now_time >= dusk or now_time <= dawn }}

      '
  actions:
  - type: turn_on
    device_id: 5c4d9055d0e5249831140c78549fbe47
    entity_id: light.schranklicht
    domain: light
    flash: short
  mode: single
- id: '1753078468164'
  alias: Wohnzimmer_TV_Nutzungsdauer_zählen
  description: Zählt die Minuten, die der Fernseher eingeschaltet ist.
  triggers:
  - minutes: /1
    trigger: time_pattern
  conditions:
  - condition: state
    entity_id: media_player.wohnzimmer_tv_samsung_q90_series_75
    state: 'on'
  actions:
  - target:
      entity_id: counter.wohnzimmer_tv_watch_minutes
    action: counter.increment
  mode: single
- id: '1753078838414'
  alias: Wohnzimmer_TV_Steckdose_aus_nach_Zeitlimit
  description: Schaltet die Steckdose aus, wenn das TV-Zeitlimit erreicht ist
  triggers:
  - minutes: /1
    trigger: time_pattern
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_tv_kindersicherung
    state: 'on'
  - condition: template
    value_template: "{{ states('counter.wohnzimmer_tv_watch_minutes') | int >\n   states('input_number.wohnzimmer_tv_timer_number')
      | int }}\n"
  actions:
  - target:
      entity_id: switch.wohnzimmer_smartplug_tv
    action: switch.turn_off
  mode: single
- id: '1753081050526'
  alias: Wohnzimmer_TV_Zeit_zählen_Quelle
  description: Zählt die Minuten je nach aktiver TV-Quelle
  triggers:
  - minutes: /1
    trigger: time_pattern
  conditions:
  - condition: state
    entity_id: media_player.wohnzimmer_tv_samsung_q90_series_75
    state: 'on'
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: '{% set src = state_attr(''media_player.wohnzimmer_tv_samsung_q90_series_75'',''source'')
          %} {{ src == ''HDMI'' }}

          '
      sequence:
      - target:
          entity_id: input_number.tv_minute_count_hdmi
        data:
          value: '{{ states(''input_number.tv_minute_count_hdmi'') | int + 1 }}'
        action: input_number.set_value
    - conditions:
      - condition: template
        value_template: '{% set src = state_attr(''media_player.wohnzimmer_tv_samsung_q90_series_75'',''source'')
          %} {{ src == ''Netflix'' }}

          '
      sequence:
      - target:
          entity_id: input_number.tv_minute_count_netflix
        data:
          value: '{{ states(''input_number.tv_minute_count_netflix'') | int + 1 }}'
        action: input_number.set_value
    - conditions:
      - condition: template
        value_template: '{% set src = state_attr(''media_player.wohnzimmer_tv_samsung_q90_series_75'',''source'')
          %} {{ src == ''YouTube'' }}

          '
      sequence:
      - target:
          entity_id: input_number.tv_minute_count_youtube
        data:
          value: '{{ states(''input_number.tv_minute_count_youtube'') | int + 1 }}'
        action: input_number.set_value
    - conditions:
      - condition: template
        value_template: '{% set src = state_attr(''media_player.wohnzimmer_tv_samsung_q90_series_75'',''source'')
          %} {{ src == ''Prime Video'' }}

          '
      sequence:
      - target:
          entity_id: input_number.tv_minute_count_prime
        data:
          value: '{{ states(''input_number.tv_minute_count_prime'') | int + 1 }}'
        action: input_number.set_value
  mode: single
- id: '1753082518657'
  alias: TV Quell-Zähler zurücksetzen
  description: ''
  triggers:
  - at: 00:00:00
    trigger: time
  actions:
  - data:
      entity_id: input_number.tv_minute_count_disney
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.tv_minute_count_hdmi
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.tv_minute_count_netflix
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.tv_minute_count_plex
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.tv_minute_count_prime
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.wohnzimmer_tv_minute_count_tv
      value: 0
    action: input_number.set_value
  - data:
      entity_id: input_number.tv_minute_count_youtube
      value: 0
    action: input_number.set_value
  - data:
      entity_id: counter.wohnzimmer_tv_watch_minutes
    action: counter.reset
- id: '1754902740359'
  alias: wohnzimmer_tv_kindersicherung_toggle
  description: Schaltet die Steckdose ein, wenn die Kindersicherung deaktiviert wird
  triggers:
  - entity_id: input_boolean.wohnzimmer_tv_kindersicherung
    from: 'on'
    to: 'off'
    trigger: state
  conditions: []
  actions:
  - target:
      entity_id: switch.wohnzimmer_smartplug_tv
    action: switch.turn_on
  mode: single
- id: '1755459782243'
  alias: Wohnzimmer TV AmbiLights aus
  description: Schaltet die AmbiLights im Wohnzimmer aus, wenn der Fernseher ausgeschaltet
    wird.
  triggers:
  - device_id: abfc6f43b455bcd3e650dcf12b20f75e
    domain: media_player
    entity_id: media_player.wohnzimmer_tv
    type: turned_off
    trigger: device
  conditions: []
  actions:
  - type: turn_off
    device_id: 5c4d9055d0e5249831140c78549fbe47
    entity_id: light.ambilight_wohnzimmer
    domain: light
    flash: short
  mode: single
- id: '1756481008405'
  alias: Gardena Zeitplan Bewässerung
  description: Öffnet das Gardena Ventil morgens oder abends nach Zeitplan, nur an
    aktivierten Wochentagen.
  triggers:
  - at: input_datetime.gardena_morgen_start
    trigger: time
  - at: input_datetime.gardena_abend_start
    trigger: time
  conditions:
  - condition: template
    value_template: "{% set day = now().weekday() %} {% set booleans = [\n  'input_boolean.gardena_mo',\n
      \ 'input_boolean.gardena_di',\n  'input_boolean.gardena_mi',\n  'input_boolean.gardena_do',\n
      \ 'input_boolean.gardena_fr',\n  'input_boolean.gardena_sa',\n  'input_boolean.gardena_so']
      %}\n{{ is_state(booleans[day], 'on') }}\n"
  actions:
  - target:
      entity_id: valve.garten_gardena_ventil_1
    action: valve.open
  - data:
      message: 'Gardena Ventil geöffnet um {{ now().strftime(''%H:%M'') }} für  {{
        states(''input_number.gardena_dauer'') | int(5) }} Minuten.

        '
      level: info
    action: system_log.write
  - delay:
      minutes: '{{ states(''input_number.gardena_dauer'') | int(5) }}'
  - target:
      entity_id: valve.garten_gardena_ventil_1
    action: valve.close
  - data:
      message: Gardena Ventil geschlossen um {{ now().strftime('%H:%M') }}
      level: info
    action: system_log.write
  mode: restart
- id: '1758805020047'
  alias: Messages_Notification
  description: Triggert eine Notification, wenn eine der Messages auf true geht.
  triggers:
  - entity_id:
    - sensor.kueche_geschirrspueler_message
    - sensor.kueche_backofen_message
    - sensor.waschkeller_trockner_message
    - sensor.garten_grundwasser_message
    - sensor.oelkeller_flutsensor_message
    - sensor.oelkeller_flutsensor_batterie_message
    - sensor.arbeitszimmer_thermostat_batterie_message
    to: 'True'
    trigger: state
  actions:
  - data:
      title: "{% set type = state_attr(msg_sensor,'message_type') %} {% set emoji
        = '\U0001F514' %} {% if type == 'info' %}{% set emoji = '\U0001F4A1' %} {%
        elif type == 'warning' %}{% set emoji = '⚠️' %} {% elif type == 'error' %}{%
        set emoji = '❌' %}{% endif %} {{ emoji }} {{ state_attr(msg_sensor,'message_title')
        }}\n"
      message: '{{ state_attr(msg_sensor,''message'') }}'
      data:
        ttl: 0
        priority: high
    action: notify.mobile_app_sm_g991b
  - data:
      title: "{% set type = state_attr(msg_sensor,'message_type') %} {% set emoji
        = '\U0001F514' %} {% if type == 'info' %}{% set emoji = '\U0001F4A1' %} {%
        elif type == 'warning' %}{% set emoji = '⚠️' %} {% elif type == 'error' %}{%
        set emoji = '❌' %}{% endif %} {{ emoji }} {{ state_attr(msg_sensor,'message_title')
        }}\n"
      message: '{{ state_attr(msg_sensor,''message'') }}'
      data:
        ttl: 0
        priority: high
    action: notify.mobile_app_rmx3085
  variables:
    msg_sensor: '{{ trigger.entity_id }}'
  mode: single
- id: '1769991000000'
  alias: Arbeitszimmer_Thermostat_Zeitplan_sync
  description: Synchronisiert die Zeitplan-Helper mit dem Thermostat-Zeitplan.
  triggers:
  - entity_id:
    - input_boolean.arbeitszimmer_thermostat_schedule_same
    - input_datetime.arbeitszimmer_thermostat_schedule_common_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_common_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_common_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_common_4_time
    - input_number.arbeitszimmer_thermostat_schedule_common_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_common_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_common_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_common_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_monday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_monday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_monday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_monday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_monday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_monday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_monday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_monday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_tuesday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_tuesday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_tuesday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_tuesday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_tuesday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_tuesday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_tuesday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_tuesday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_wednesday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_wednesday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_wednesday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_wednesday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_wednesday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_wednesday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_wednesday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_wednesday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_thursday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_thursday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_thursday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_thursday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_thursday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_thursday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_thursday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_thursday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_friday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_friday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_friday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_friday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_friday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_friday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_friday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_friday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_saturday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_saturday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_saturday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_saturday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_saturday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_saturday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_saturday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_saturday_4_temp
    - input_datetime.arbeitszimmer_thermostat_schedule_sunday_1_time
    - input_datetime.arbeitszimmer_thermostat_schedule_sunday_2_time
    - input_datetime.arbeitszimmer_thermostat_schedule_sunday_3_time
    - input_datetime.arbeitszimmer_thermostat_schedule_sunday_4_time
    - input_number.arbeitszimmer_thermostat_schedule_sunday_1_temp
    - input_number.arbeitszimmer_thermostat_schedule_sunday_2_temp
    - input_number.arbeitszimmer_thermostat_schedule_sunday_3_temp
    - input_number.arbeitszimmer_thermostat_schedule_sunday_4_temp
    trigger: state
  variables:
    common_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_common_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_common_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_common_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_common_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_common_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_common_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_common_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_common_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    monday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_monday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_monday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_monday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_monday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_monday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_monday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_monday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_monday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    tuesday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_tuesday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_tuesday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_tuesday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_tuesday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_tuesday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_tuesday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_tuesday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_tuesday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    wednesday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_wednesday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_wednesday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_wednesday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_wednesday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_wednesday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_wednesday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_wednesday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_wednesday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    thursday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_thursday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_thursday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_thursday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_thursday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_thursday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_thursday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_thursday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_thursday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    friday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_friday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_friday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_friday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_friday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_friday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_friday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_friday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_friday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    saturday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_saturday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_saturday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_saturday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_saturday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_saturday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_saturday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_saturday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_saturday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
    sunday_schedule: >
      {% set slots = [
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_sunday_1_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_sunday_1_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_sunday_2_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_sunday_2_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_sunday_3_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_sunday_3_temp')},
        {'t': states('input_datetime.arbeitszimmer_thermostat_schedule_sunday_4_time'), 'temp': states('input_number.arbeitszimmer_thermostat_schedule_sunday_4_temp')}
      ] %}
      {% set parts = [] %}
      {% for s in slots %}
        {% if s.t not in ['unknown','unavailable',''] and s.temp not in ['unknown','unavailable',''] %}
          {% set parts = parts + [ s.t[0:5] ~ '/' ~ (s.temp | float(0)) ] %}
        {% endif %}
      {% endfor %}
      {{ parts | join(' ') }}
  actions:
  - choose:
    - conditions:
      - condition: state
        entity_id: input_boolean.arbeitszimmer_thermostat_schedule_same
        state: 'on'
      sequence:
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_monday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_tuesday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_wednesday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_thursday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_friday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_saturday
          value: '{{ common_schedule }}'
        action: text.set_value
      - data:
          entity_id: text.arbeitszimmer_thermostat_weekly_schedule_sunday
          value: '{{ common_schedule }}'
        action: text.set_value
    default:
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_monday
        value: '{{ monday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_tuesday
        value: '{{ tuesday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_wednesday
        value: '{{ wednesday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_thursday
        value: '{{ thursday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_friday
        value: '{{ friday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_saturday
        value: '{{ saturday_schedule }}'
      action: text.set_value
    - data:
        entity_id: text.arbeitszimmer_thermostat_weekly_schedule_sunday
        value: '{{ sunday_schedule }}'
      action: text.set_value
  mode: single
- id: '1760956184095'
  alias: wohnzimmer_terrarium_lampe1_einschalten
  description: Schaltet die Lampe 1 (Bright Sun) zur geplanten Zeit ein.
  triggers:
  - at: input_datetime.wohnzimmer_terrarium_lampe1_on
    trigger: time
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_terrarium_timer_active
    state: 'on'
  actions:
  - target:
      entity_id: switch.wohnzimmer_smartplug_terrarium_1
    action: switch.turn_on
  - data:
      message: '[Terrarium] Lampe ''Bright Sun'' eingeschaltet um {{ now().strftime(''%H:%M'')
        }}'
      level: info
    action: system_log.write
  mode: single
- id: '1760956227580'
  alias: Wohnzimmer_Terrarium_Lampe1_Ausschalten
  description: Schaltet die Lampe 1 (Bright Sun) zur geplanten Zeit aus.
  triggers:
  - at: input_datetime.wohnzimmer_terrarium_lampe1_off
    trigger: time
  conditions:
  - condition: state
    entity_id: input_boolean.wohnzimmer_terrarium_timer_active
    state: 'on'
  actions:
  - target:
      entity_id: switch.wohnzimmer_smartplug_terrarium_1
    action: switch.turn_off
  - data:
      message: '[Terrarium] Lampe ''Bright Sun'' ausgeschaltet um {{ now().strftime(''%H:%M'')
        }}'
      level: info
    action: system_log.write
  mode: single
